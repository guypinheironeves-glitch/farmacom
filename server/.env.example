# Porta da API
PORT=3333

# Banco PostgreSQL (o docker-compose da raiz cria este banco)
DATABASE_URL=postgres://farmacom:farmacom@localhost:5432/farmacom
DATABASE_URL_TEST=postgres://farmacom:farmacom@localhost:5432/farmacom_test
# Use true em bancos na nuvem que exigem SSL (Neon, Render, Supabase)
DATABASE_SSL=false

# Segredo dos tokens de login. Obrigatório: a API não sobe sem ele. Em produção, gere um valor longo e aleatório.
JWT_SECRET=troque-este-segredo

# Fuso usado para "hoje" e "vencido"
APP_TIMEZONE=America/Sao_Paulo

# Endereços do frontend autorizados a chamar a API (separados por vírgula).
# Vazio libera qualquer origem: use só em desenvolvimento.
CORS_ORIGIN=

# Chave do endereço /api/avisos/disparar, usado por um agendador externo
AVISOS_CHAVE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
WHATSAPP_API_URL=
WHATSAPP_INSTANCIA=
WHATSAPP_TOKEN=
