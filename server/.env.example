# Porta da API
PORT=3333

# Banco PostgreSQL (o docker-compose da raiz cria este banco)
DATABASE_URL=postgres://farmacom:farmacom@localhost:5432/farmacom
DATABASE_URL_TEST=postgres://farmacom:farmacom@localhost:5432/farmacom_test
# Use true em bancos na nuvem que exigem SSL (Neon, Render, Supabase)
DATABASE_SSL=false

# Segredo para assinar os tokens de login (troque em produção)
JWT_SECRET=troque-este-segredo

# Fuso usado para "hoje" e "vencido"
APP_TIMEZONE=America/Sao_Paulo

# Endereços do frontend autorizados a chamar a API (separados por vírgula). Vazio libera todos.
CORS_ORIGIN=
