{
  "name": "farmacom-server",
  "version": "0.1.0",
  "private": true,
  "description": "API do FarmaCom: controle de estoque e validade para farmácias de bairro",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
